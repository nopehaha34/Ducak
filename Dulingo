local function makeRow(parent, text, pillText, withLock, order)
    local holder = make("Frame", {
        Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 3,
    }, parent)
    local btn = make("TextButton", {
        Size = UDim2.new(1, withLock and -68 or 0, 1, 0), BackgroundColor3 = C.row,
        BackgroundTransparency = 0.2, Text = "", AutoButtonColor = false, ZIndex = 4,
    }, holder)
    corner(btn)
    local st = stroke(btn, C.purple, 1.2, 0.35)
    make("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
        Text = text, Font = Enum.Font.GothamBold, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.text, ZIndex = 5,
    }, btn)
    local pill = make("TextLabel", {
        Size = UDim2.fromOffset(46, 22), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0), BackgroundColor3 = C.off, Text = pillText,
        Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.text, ZIndex = 5,
    }, btn)
    corner(pill, UDim.new(1, 0))

    local row = { Button = btn }
    function row.SetOn(on)
        pill.Text = on and "ON" or "OFF"
        TweenService:Create(pill, TweenInfo.new(0.15), {
            BackgroundColor3 = on and C.cyan or C.off,
            TextColor3 = on and C.dark or C.text,
        }):Play()
        TweenService:Create(st, TweenInfo.new(0.15), {
            Color = on and C.cyan or C.purple, Transparency = on and 0 or 0.35,
        }):Play()
    end
    function row.Flash(txt, dur)
        pill.Text = txt
        task.delay(dur or 1, function() if pill.Parent then pill.Text = pillText end end)
    end
    if withLock then
        local lock = make("TextButton", {
            Size = UDim2.fromOffset(60, 40), AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0), BackgroundColor3 = C.row, BackgroundTransparency = 0.2,
            Text = "Move", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.pink,
            AutoButtonColor = false, ZIndex = 4,
        }, holder)
        corner(lock)
        stroke(lock, C.pink, 1.2, 0.35)
        row.Lock = lock
    end
    return row
end
