-- multi-select dropdown with a search box; getItems() returns { { key = "...", text = "..." }, ... }
local function makeDropdown(parent, title, order, getItems)
    local selected = {}
    local isOpen = false
    local CLOSED_H, OPEN_H = 40, 40 + 6 + 30 + 6 + 120
    local holder = make("Frame", {
        Size = UDim2.new(1, 0, 0, CLOSED_H), BackgroundTransparency = 1, LayoutOrder = order,
        ClipsDescendants = true, ZIndex = 4,
    }, parent)
    local head = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.row, BackgroundTransparency = 0.2,
        Text = "", AutoButtonColor = false, ZIndex = 5,
    }, holder)
    corner(head)
    stroke(head, C.purple, 1.2, 0.35)
    local label = make("TextLabel", {
        Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
        Text = title, Font = Enum.Font.GothamBold, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.text, ZIndex = 6,
    }, head)
    local arrow = make("TextLabel", {
        Size = UDim2.fromOffset(24, 40), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0),
        BackgroundTransparency = 1, Text = "v", Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = C.cyan, ZIndex = 6,
    }, head)
    local search = make("TextBox", {
        Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 46), BackgroundColor3 = C.row,
        BackgroundTransparency = 0.2, Text = "", PlaceholderText = "Search name",
        PlaceholderColor3 = Color3.fromRGB(140, 130, 190), Font = Enum.Font.GothamBold, TextSize = 13,
        TextColor3 = C.text, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
    }, holder)
    corner(search, UDim.new(0, 8))
    make("UIPadding", { PaddingLeft = UDim.new(0, 10) }, search)
    local list = make("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 120), Position = UDim2.fromOffset(0, 82), BackgroundTransparency = 1,
        BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3, ScrollBarImageColor3 = C.purple, ZIndex = 5,
    }, holder)
    make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)

    local function count()
        local n = 0
        for _ in pairs(selected) do n = n + 1 end
        return n
    end
    local function updateLabel()
        local n = count()
        label.Text = (n > 0) and (title .. " (" .. n .. ")") or title
    end

    local function rebuild()
        for _, ch in ipairs(list:GetChildren()) do
            if not ch:IsA("UIListLayout") then ch:Destroy() end
        end
        local q = string.lower(search.Text)
        local n = 0
        for _, item in ipairs(getItems()) do
            if q == "" or string.find(string.lower(item.text), q, 1, true) then
                n = n + 1
                local on = selected[item.key] == true
                local b = make("TextButton", {
                    Size = UDim2.new(1, -6, 0, 26), BackgroundColor3 = on and C.purple or C.row,
                    BackgroundTransparency = on and 0.1 or 0.3, Text = item.text,
                    Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.text,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                    AutoButtonColor = false, LayoutOrder = n, ZIndex = 6,
                }, list)
                corner(b, UDim.new(0, 7))
                make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 8) }, b)
                b.Activated:Connect(function()
                    if selected[item.key] then selected[item.key] = nil else selected[item.key] = true end
                    local nowOn = selected[item.key] == true
                    b.BackgroundColor3 = nowOn and C.purple or C.row
                    b.BackgroundTransparency = nowOn and 0.1 or 0.3
                    updateLabel()
                end)
            end
        end
        if n == 0 then
            make("TextLabel", {
                Size = UDim2.new(1, -6, 0, 26), BackgroundTransparency = 1, Text = "Nothing to show",
                Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Color3.fromRGB(170, 165, 220), ZIndex = 6,
            }, list)
        end
    end

    head.Activated:Connect(function()
        isOpen = not isOpen
        arrow.Text = isOpen and "^" or "v"
        holder.Size = UDim2.new(1, 0, 0, isOpen and OPEN_H or CLOSED_H)
        if isOpen then rebuild() end
    end)
    search:GetPropertyChangedSignal("Text"):Connect(function()
        if isOpen then rebuild() end
    end)

    return {
        Holder = holder,
        Selected = selected,
        Refresh = function() if isOpen then rebuild() end end,
    }
end

