-- Human tab: Auto attack, Bloxy loop, Instant grab, Instant get
local H = { autoOn = false, getOn = false, bxLoop = false, bxNear = false, lastAuto = 0, lastGet = 0, lastUi = 0 }

-- Auto attack: swing when a non-whitelisted enemy is within 11 studs
function H.autoStep(myHrp)
    local _, aHrp, aDist = nearestEnemy(myHrp, true)
    if aHrp and aDist <= CFG.AutoAttackRange then
        local now = os.clock()
        if now - H.lastAuto >= CFG.SwingDelay then
            H.lastAuto = now
            swing()
        end
    end
end

-- Bloxy loop: the lock icon disappears within 30 studs of the spot; tap = repeat the Bloxy sequence, tap again = stop
function H.refreshBx()
    local btn = bxLoopCircle.Button
    if not H.bxNear then
        btn.Text, btn.TextSize = "\u{1F512}", 26
    else
        btn.TextSize = 12
        btn.Text = H.bxLoop and "STOP" or "LOOP"
    end
end

function H.bxLoopStart()
    if H.bxLoop then return end
    H.bxLoop = true
    H.refreshBx()
    task.spawn(function()
        while H.bxLoop do
            local t0 = os.clock()
            local hum, char = getHum(), LP.Character
            local bp = LP:FindFirstChildOfClass("Backpack")
            if hum and char and bp and not bloxyBusy then
                bloxyBusy = true
                bloxySequence(hum, char, bp)
                bloxyBusy = false
            end
            while H.bxLoop and os.clock() - t0 < CFG.BloxyCooldown do task.wait(0.1) end
        end
        H.refreshBx()
    end)
end

function H.bxLoopStop()
    H.bxLoop = false
    H.refreshBx()
end

function H.setBxLoop(on)
    rowBxLoop.SetOn(on)
    bxLoopCircle.Button.Visible = on
    if on then
        local hrp = getHRP()
        H.bxNear = hrp ~= nil and (hrp.Position - CFG.BloxyLoopPos).Magnitude <= CFG.BloxyLoopRadius
    else
        H.bxLoop = false
    end
    H.refreshBx()
end

-- Instant grab: the circle stays faded until the Grab tool is equipped, then tap = teleport
function H.grabEquipped()
    local c = LP.Character
    local t = c and c:FindFirstChild("Grab")
    return t ~= nil and t:IsA("Tool")
end

function H.grabUse()
    if not H.grabEquipped() then return end
    local hrp = getHRP()
    if not hrp then return end
    bypassIgnoreUntil = os.clock() + 1.5
    hrp.CFrame = CFG.GrabCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
end

function H.setGrab(on)
    rowGrab.SetOn(on)
    grabCircle.Button.Visible = on
    grabCircle.SetGhost(on and not H.grabEquipped() or false)
end

-- Instant get: stand on every picked item (workspace.PickItem) and fire its prompts every 0.1s,
-- skip an item once a tool with the same name is in the backpack; independent of Auto pickup
function H.itemPos(inst)
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local part = inst:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position
end

function H.itemPrompts(inst)
    local list = {}
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("ProximityPrompt") then list[#list + 1] = d end
    end
    return list
end

function H.getStep(myHrp)
    local now = os.clock()
    if now - H.lastGet >= CFG.GetInterval then
        H.lastGet = now
        local picked = {}
        for name in pairs(pickDrop.Selected) do picked[#picked + 1] = name end
        table.sort(picked, function(a, b) return string.lower(a) < string.lower(b) end)

        local owned = ownedTools()
        H.target = nil
        local folder = workspace:FindFirstChild("PickItem")
        if folder then
            for _, name in ipairs(picked) do
                if not owned[norm(name)] then
                    local best, bestD
                    for _, ch in ipairs(folder:GetChildren()) do
                        if ch.Name == name then
                            local pos = H.itemPos(ch)
                            if pos then
                                local d = (pos - myHrp.Position).Magnitude
                                if not bestD or d < bestD then best, bestD = ch, d end
                            end
                        end
                    end
                    if best then
                        H.target = best
                        break
                    end
                end
            end
        end
        if H.target then
            for _, pr in ipairs(H.itemPrompts(H.target)) do
                if pr.Enabled then firePrompt(pr) end
            end
        end
    end

    -- lock on the item's position every frame
    local t = H.target
    if t and t.Parent then
        local pos = H.itemPos(t)
        if pos then
            bypassIgnoreUntil = now + 1
            myHrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
            myHrp.AssemblyLinearVelocity = Vector3.zero
        end
    end
end

function H.setGet(on)
    H.getOn = on
    H.target = nil
    rowGet.SetOn(on)
end

function H.setAuto(on)
    H.autoOn = on
    rowAuto.SetOn(on)
end

local function humanStep(hum, myHrp)
    if H.autoOn then H.autoStep(myHrp) end
    if H.getOn then H.getStep(myHrp) end
    local now = os.clock()
    if now - H.lastUi >= 0.2 then
        H.lastUi = now
        if bxLoopCircle.Button.Visible then
            local near = (myHrp.Position - CFG.BloxyLoopPos).Magnitude <= CFG.BloxyLoopRadius
            if near ~= H.bxNear then
                H.bxNear = near
                if not near then H.bxLoop = false end
                H.refreshBx()
            end
        end
        if grabCircle.Button.Visible then grabCircle.SetGhost(not H.grabEquipped()) end
    end
end

---------------------------------------------------------------- MAIN LOOP
local lastSwing = 0
track(RunService.Heartbeat:Connect(function()
    if npcOn then applyNpcHitbox() end
    if pathOn then
        local pt = os.clock()
        if pt - lastPathScan >= 0.5 then
            lastPathScan = pt
            pathStep()
        end
    end

    if espOn then
        local et = os.clock()
        if et - lastEspScan >= 0.4 then
            lastEspScan = et
            espStep()
        end
    end

    local hum, myHrp = getHum(), getHRP()
    if not (hum and myHrp) then return end

    if bypassOn then bypassStep(hum, myHrp) end
    humanStep(hum, myHrp)

    local mode = activeMode()
    if mode then
        local cfg = CFG[mode]
        local speed = cfg.Speed
        if mode == "ProPlayer" then
            speed = MX.isRunning() and cfg.RunSpeed or cfg.IdleSpeed
            MX.jumpGuard(hum)
        elseif mode == "Extreme" then
            MX.applyExtreme(hum)
        end
        if hum.WalkSpeed ~= speed then hum.WalkSpeed = speed end -- loop speed
        applyHitbox(cfg.Hitbox)                                   -- loop hitbox
    end

    if pickupOn then
        local t = os.clock()
        if t - lastPickupScan >= 0.25 then
            lastPickupScan = t
            pickupStep(myHrp)
        end
    end

    if not (mode or followActive) then return end

    -- swing when a non-whitelisted enemy is within 8 studs
    if mode and not CFG[mode].NoSwing then
        local _, sHrp, sDist = nearestEnemy(myHrp, true)
        if sHrp and sDist <= CFG.SwingRange then
            local now = os.clock()
            if now - lastSwing >= CFG.SwingDelay then
                lastSwing = now
                swing()
            end
        end
    end

    if not followActive then return end
    local _, tHrp, dist = nearestEnemy(myHrp)
    if not tHrp then return end

    -- follow nearest enemy
    if followActive then
        if dist > CFG.FollowStop then
            hum:MoveTo(tHrp.Position)
        else
            hum:MoveTo(myHrp.Position)
        end
        if dist <= CFG.SwingRange + 4 then
            local mp, tp = myHrp.Position, tHrp.Position
            local flat = Vector3.new(tp.X - mp.X, 0, tp.Z - mp.Z)
            if flat.Magnitude > 0.5 then
                myHrp.CFrame = CFrame.lookAt(mp, Vector3.new(tp.X, mp.Y, tp.Z))
            end
        end
    end
end))

