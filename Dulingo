local PURPLE = Color3.fromRGB(170, 70, 255)

local function recolor(inst)
    local function one(o)
        pcall(function()
            if o:IsA("ParticleEmitter") or o:IsA("Beam") or o:IsA("Trail") then
                o.Color = ColorSequence.new(PURPLE)
            elseif o:IsA("Light") then
                o.Color = PURPLE
            elseif o:IsA("Sparkles") then
                o.SparkleColor = PURPLE
            elseif o:IsA("Fire") then
                o.Color, o.SecondaryColor = PURPLE, PURPLE
            elseif o:IsA("Smoke") then
                o.Color = PURPLE
            elseif o:IsA("BasePart") then
                o.Color = PURPLE
            end
        end)
    end
    one(inst)
    for _, d in ipairs(inst:GetDescendants()) do one(d) end
end

-- Lightning effect copied from the Crucible blade, recolored purple
local function findLightning()
    local ok, inst = pcall(function()
        return workspace.PickItem.Crucible.Crucible.WeldParts.Blade.Lightning
    end)
    if ok and inst then
        local c = inst:Clone()
        recolor(c)
        return c
    end
end
local lightningTemplate = findLightning()

local function addLightning(part, cf, emitters, template)
    if not template then
        lightningTemplate = lightningTemplate or findLightning()
        template = lightningTemplate
    end
    if not template then return end
    local fx = template:Clone()
    local all = { fx }
    for _, d in ipairs(fx:GetDescendants()) do all[#all + 1] = d end
    for _, o in ipairs(all) do
        if o:IsA("ParticleEmitter") then
            o.Enabled = true
            emitters[#emitters + 1] = o
            pcall(function() o:Emit(15) end)
        elseif o:IsA("Beam") then
            local a0, a1 = o.Attachment0, o.Attachment1
            local internal = a0 and a1
                and (a0 == fx or a0:IsDescendantOf(fx)) and (a1 == fx or a1:IsDescendantOf(fx))
            if not internal then
                o.Attachment0 = make("Attachment", { Position = Vector3.new(0, 0, 0) }, part)
                o.Attachment1 = make("Attachment", { Position = Vector3.new(0, 7, 0) }, part)
            end
        elseif o:IsA("BasePart") then
            o.Anchored, o.CanCollide, o.CanQuery, o.CanTouch = true, false, false, false
        end
    end
    if fx:IsA("BasePart") then
        fx.CFrame = cf
    elseif fx:IsA("Model") then
        fx:PivotTo(cf)
    end
    fx.Parent = part
    return fx
end

local function smokePuff(cf, duration)
    local part = make("Part", {
        Name = "CosmosSmoke", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
        Transparency = 1, Size = Vector3.new(5, 1, 5), CFrame = cf,
    }, workspace)
    local pe = make("ParticleEmitter", {
        Texture = "rbxasset://textures/particles/smoke_main.dds",
        Color = ColorSequence.new(Color3.fromRGB(10, 6, 18), Color3.fromRGB(55, 30, 90)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.05),
            NumberSequenceKeypoint.new(0.7, 0.35),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 20),
        }),
        Lifetime = NumberRange.new(1.6, 2.6),
        Rate = 140,
        Speed = NumberRange.new(3, 9),
        SpreadAngle = Vector2.new(60, 60),
        Rotation = NumberRange.new(0, 360),
        RotSpeed = NumberRange.new(-60, 60),
        EmissionDirection = Enum.NormalId.Top,
    }, part)
    pe:Emit(40)
    local emitters = { pe }
    addLightning(part, cf, emitters)
    task.delay(duration, function()
        for _, e in ipairs(emitters) do e.Enabled = false end
    end)
    task.delay(duration + 3, function() part:Destroy() end)
end

local tpBusy = false
local function runTeleport()
    if tpBusy then return end
    local hrp = getHRP()
    if not hrp then return end
    tpBusy = true

    local team = LP.Team
    local dest = (team and team.Name == "Human") and TP.Human or TP.Infected

    tpCircle.Button.Text = "..."
    smokePuff(hrp.CFrame * CFrame.new(0, -1.5, 0), CFG.TeleportDelay)
    task.wait(CFG.TeleportDelay)

    local now = getHRP()
    if now then
        bypassIgnoreUntil = os.clock() + 1.5
        now.CFrame = dest
        now.AssemblyLinearVelocity = Vector3.zero
        smokePuff(dest * CFrame.new(0, -1.5, 0), 0.8)
    end
    tpCircle.Button.Text = "TP"
    tpBusy = false
end

-- Auto pickup
local pickupOn = false
local promptSet = {}
local pickupConns = {}
local lastFire = setmetatable({}, { __mode = "k" })
local lastPickupScan = 0

local function norm(s) return (string.lower(s):gsub("[^%w]", "")) end

local function ownedTools()
    local set = {}
    local function scan(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") then set[norm(t.Name)] = true end
        end
    end
    scan(LP:FindFirstChildOfClass("Backpack"))
    scan(LP.Character)
    return set
end

-- names a prompt could be "for": its texts and the parent / grandparent names
local function promptNames(pr)
    local names = {}
    local function add(s)
        if type(s) == "string" and s ~= "" then names[#names + 1] = norm(s) end
    end
    add(pr.ObjectText)
    add(pr.ActionText)
    local p = pr.Parent
    if p then
        add(p.Name)
        if p.Parent and p.Parent ~= workspace then add(p.Parent.Name) end
    end
    return names
end

local function alreadyOwned(pr, owned)
    for _, n in ipairs(promptNames(pr)) do
        if n ~= "" and owned[n] then return true end
    end
    return false
end

local function keywordOK(pr)
    if #CFG.PickupKeywords == 0 then return true end
    local text = string.lower(pr.ActionText .. " " .. pr.ObjectText .. " " .. (pr.Parent and pr.Parent.Name or ""))
    for _, k in ipairs(CFG.PickupKeywords) do
        if string.find(text, string.lower(k), 1, true) then return true end
    end
    return false
end

local function promptPosition(pr)
    local p = pr.Parent
    if not p then return end
    if p:IsA("BasePart") then return p.Position end
    if p:IsA("Attachment") then return p.WorldPosition end
    if p:IsA("Model") then return p:GetPivot().Position end
end

local function firePrompt(pr)
    task.spawn(function()
        pcall(function()
            pr.HoldDuration = 0
            if fireproximityprompt then
                fireproximityprompt(pr)
            else
                pr:InputHoldBegin()
                task.wait()
                pr:InputHoldEnd()
            end
        end)
    end)
end

local function isSkipped(pr, roots)
    for _, root in ipairs(roots) do
        if pr:IsDescendantOf(root) then return true end
    end
    return false
end

local function pickupStep(myHrp)
    local owned = ownedTools()
    local now = os.clock()
    local skipRoots = {}
    for _, name in ipairs(CFG.PickupSkip) do
        local f = workspace:FindFirstChild(name)
        if f then skipRoots[#skipRoots + 1] = f end
    end
    for pr in pairs(promptSet) do
        if pr.Parent and pr.Enabled and (now - (lastFire[pr] or 0)) >= 0.6
            and not isSkipped(pr, skipRoots) then
            local pos = promptPosition(pr)
            if pos and (pos - myHrp.Position).Magnitude <= CFG.PickupRange
                and not alreadyOwned(pr, owned) and keywordOK(pr) then
                lastFire[pr] = now
                firePrompt(pr)
            end
        end
    end
end

local function setPickup(on)
    pickupOn = on
    rowPickup.SetOn(on)
    for _, c in ipairs(pickupConns) do c:Disconnect() end
    pickupConns = {}
    promptSet = {}
    if on then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then promptSet[d] = true end
        end
        pickupConns[#pickupConns + 1] = workspace.DescendantAdded:Connect(function(d)
            if d:IsA("ProximityPrompt") then promptSet[d] = true end
        end)
        pickupConns[#pickupConns + 1] = workspace.DescendantRemoving:Connect(function(d)
            promptSet[d] = nil
        end)
    end
end

-- NPC hitbox
local npcOn = false
local npcSet = {}
local npcConns = {}
local savedNpc = setmetatable({}, { __mode = "k" })

local function addNpc(h)
    local m = h.Parent
    if m and m:IsA("Model") then npcSet[m] = true end
end

local function applyNpcHitbox()
    local s = Vector3.new(CFG.NpcHitbox, CFG.NpcHitbox, CFG.NpcHitbox)
    for m in pairs(npcSet) do
        if not m.Parent then
            npcSet[m] = nil
        elseif not Players:GetPlayerFromCharacter(m) then
            local hum = m:FindFirstChildOfClass("Humanoid")
            local hrp = m:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                if not savedNpc[hrp] then
                    savedNpc[hrp] = { Size = hrp.Size, Transparency = hrp.Transparency, CanCollide = hrp.CanCollide }
                end
                if hrp.Size ~= s then hrp.Size = s end
                hrp.Transparency = 0.8
                hrp.CanCollide = false
            end
        end
    end
end

local function setNpc(on)
    npcOn = on
    rowNpc.SetOn(on)
    for _, c in ipairs(npcConns) do c:Disconnect() end
    npcConns = {}
    npcSet = {}
    if on then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Humanoid") then addNpc(d) end
        end
        npcConns[#npcConns + 1] = workspace.DescendantAdded:Connect(function(d)
            if d:IsA("Humanoid") then addNpc(d) end
        end)
        npcConns[#npcConns + 1] = workspace.DescendantRemoving:Connect(function(d)
            if d:IsA("Humanoid") and d.Parent then npcSet[d.Parent] = nil end
        end)
    else
        restoreFrom(savedNpc)
    end
end

-- Check Move: green path behind every other-team player
local pathOn = false
local pathObjs = setmetatable({}, { __mode = "k" }) -- hrp -> { attachment0, attachment1, trail }
local lastPathScan = 0
local GREEN = Color3.fromRGB(60, 255, 90)

local function destroyPath(hrp)
    local o = pathObjs[hrp]
    if o then
        for _, i in ipairs(o) do pcall(function() i:Destroy() end) end
        pathObjs[hrp] = nil
    end
end

local function pathStep()
    local current = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            local _, hrp = alive(p)
            if hrp then
                current[hrp] = true
                local o = pathObjs[hrp]
                if not (o and o[3].Parent) then
                    local a0 = make("Attachment", { Name = "CosmosPath0", Position = Vector3.new(0, -2.4, 0) }, hrp)
                    local a1 = make("Attachment", { Name = "CosmosPath1", Position = Vector3.new(0, -3, 0) }, hrp)
                    local tr = make("Trail", {
                        Name = "CosmosPath", Attachment0 = a0, Attachment1 = a1,
                        Color = ColorSequence.new(GREEN), LightEmission = 1, FaceCamera = true,
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.7),
                        }),
                        Lifetime = math.clamp(CFG.PathLifetime, 0.1, 20), MinLength = 0.05,
                    }, hrp)
                    pathObjs[hrp] = { a0, a1, tr }
                end
            end
        end
    end
    for hrp in pairs(pathObjs) do
        if not current[hrp] then destroyPath(hrp) end
    end
end

local function setPath(on)
    pathOn = on
    rowPath.SetOn(on)
    if not on then
        for hrp in pairs(pathObjs) do destroyPath(hrp) end
    end
end

-- Bypass stun AC: running normally + pulled back by the anti-cheat
-- -> equip any backpack tool, unequip after 0.3s
local bypassOn = false
local bypassBusy = false
local bpHrp, bpPos, bpTime

local function bypassStep(hum, myHrp)
    local now = os.clock()
    local pos = myHrp.Position
    if bpHrp ~= myHrp then
        bpHrp, bpPos, bpTime = myHrp, pos, now
        return
    end
    local dt, delta = now - bpTime, pos - bpPos
    bpPos, bpTime = pos, now
    if bypassBusy or now < bypassIgnoreUntil or dt <= 0 then return end

    local move = hum.MoveDirection
    if move.Magnitude < 0.1 then return end -- only while running
    local flat = Vector3.new(delta.X, 0, delta.Z)
    local limit = hum.WalkSpeed * dt * 2 + CFG.StunPullDistance
    if flat.Magnitude > limit and flat.Unit:Dot(move.Unit) < -0.2 then
        bypassBusy = true
        task.spawn(function()
            local bp = LP:FindFirstChildOfClass("Backpack")
            local tools = {}
            if bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA("Tool") then tools[#tools + 1] = t end
                end
            end
            if #tools > 0 then
                hum:EquipTool(tools[math.random(#tools)])
                task.wait(0.3)
                hum:UnequipTools()
            end
            task.wait(0.5)
            bypassBusy = false
        end)
    end
end

local function setBypass(on)
    bypassOn = on
    rowBypass.SetOn(on)
    bpHrp = nil
end

-- ESP: neon red boxes, always on top (visible through walls), other-team players only
local espOn = false
local espObjs = {} -- part -> BoxHandleAdornment
local lastEspScan = 0
local ESP_RED = Color3.fromRGB(255, 30, 30)

local function destroyEsp(part)
    local a = espObjs[part]
    if a then pcall(function() a:Destroy() end) end
    espObjs[part] = nil
end

local function espStep()
    local current = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) and p.Character then
            for _, part in ipairs(p.Character:GetDescendants()) do
                -- the hitbox-enlarged HumanoidRootPart is skipped so no giant box shows up
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    current[part] = true
                    local a = espObjs[part]
                    if not (a and a.Parent) then
                        espObjs[part] = make("BoxHandleAdornment", {
                            Name = "CosmosESP", Adornee = part, Size = part.Size + Vector3.new(0.05, 0.05, 0.05),
                            Color3 = ESP_RED, Transparency = 0.25, AlwaysOnTop = true, ZIndex = 10,
                        }, part)
                    end
                end
            end
        end
    end
    for part in pairs(espObjs) do
        if not current[part] then destroyEsp(part) end
    end
end

local function setEsp(on)
    espOn = on
    rowEsp.SetOn(on)
    if not on then
        for part in pairs(espObjs) do destroyEsp(part) end
    end
end

-- Bloxy combo: one run per tap, cooldown 3s
-- unequip current tool -> Bloxiade + swing -> 0.3s -> Bloxy Cola + swing -> unequip -> re-equip original
local bloxyBusy = false
local bloxyReadyAt = 0

-- one full Bloxy sequence (used by the Bloxy combo circle and by Bloxy loop)
local function bloxySequence(hum, char, bp)
    pcall(function()
        local original = char:FindFirstChildOfClass("Tool")
        hum:UnequipTools()
        task.wait() -- let the tools go back to the backpack

        local function useTool(name)
            local t = bp:FindFirstChild(name)
            if t and t:IsA("Tool") then
                hum:EquipTool(t)
                task.wait(0.05) -- let the tool finish equipping before swinging
                swing()
            end
        end

        useTool("Bloxiade")
        task.wait(CFG.BloxyGap)
        useTool("Bloxy Cola")
        task.wait(CFG.BloxyFinishDelay)

        hum:UnequipTools()
        if original and original.Parent then
            task.wait()
            hum:EquipTool(original)
        end
    end)
end

local function bloxyCombo()
    if bloxyBusy or os.clock() < bloxyReadyAt then return end
    local hum, char = getHum(), LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    if not (hum and char and bp) then return end

    bloxyBusy = true
    bloxyReadyAt = os.clock() + CFG.BloxyCooldown

    task.spawn(function() -- cooldown countdown on the circle
        local btn = bloxyCircle.Button
        while os.clock() < bloxyReadyAt and btn.Parent do
            btn.Text = string.format("%.1f", bloxyReadyAt - os.clock())
            task.wait(0.1)
        end
        if btn.Parent then btn.Text = "BLOXY" end
    end)

    bloxySequence(hum, char, bp)
    bloxyBusy = false
end

