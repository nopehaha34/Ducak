-- circle positions are saved to a file (needs writefile / readfile in your executor)
local HttpService = game:GetService("HttpService")
local SAVE_FILE = "CosmosUI_positions.json"
local savedPos = {}
local circles = {}
pcall(function()
    if isfile and readfile and isfile(SAVE_FILE) then
        local data = HttpService:JSONDecode(readfile(SAVE_FILE))
        if type(data) == "table" then savedPos = data end
    end
end)
local function savePositions()
    pcall(function()
        if writefile then writefile(SAVE_FILE, HttpService:JSONEncode(savedPos)) end
    end)
end

local function makeCircle(label, pos, accent, activeLabel)
    local default = pos
    local s = savedPos[label]
    if type(s) == "table" and #s == 4 then
        pos = UDim2.new(s[1], s[2], s[3], s[4])
    end
    local c = make("TextButton", {
        Name = label .. "Circle", Size = UDim2.fromOffset(66, 66), Position = pos,
        BackgroundColor3 = Color3.new(1, 1, 1), Text = label, Font = Enum.Font.GothamBlack,
        TextSize = 12, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.6,
        AutoButtonColor = false, Visible = false, ZIndex = 20,
    }, gui)
    corner(c, UDim.new(1, 0))
    local grad = make("UIGradient", { Color = ColorSequence.new(C.purple, C.bg2), Rotation = 45 }, c)
    local st = stroke(c, accent, 2.5, 0)
    local o = { Button = c, Locked = false }
    makeDraggable(c, c, function() return not o.Locked end, function()
        local p = c.Position
        savedPos[label] = { p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset }
        savePositions()
    end)
    function o.ResetPosition()
        c.Position = default
        savedPos[label] = nil
    end
    circles[#circles + 1] = o
    function o.Refresh()
        c.BackgroundTransparency = o.Ghost and 0.85 or (o.Locked and 0 or 0.45)
        c.TextTransparency = o.Ghost and 0.7 or 0
        c.TextStrokeTransparency = o.Ghost and 1 or 0.6
        st.Transparency = o.Ghost and 0.8 or (o.Locked and 0 or 0.5)
    end
    function o.SetLocked(l)
        o.Locked = l
        o.Refresh()
    end
    function o.SetGhost(g)
        o.Ghost = g
        o.Refresh()
    end
    function o.SetActive(a)
        grad.Color = a and ColorSequence.new(accent, C.purple) or ColorSequence.new(C.purple, C.bg2)
        c.Text = a and (activeLabel or label) or label
    end
    o.SetLocked(false)
    return o
end

