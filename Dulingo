---------------------------------------------------------------- GAME LOGIC
local state = { Heresy = false, Pro = false, ProPlayer = false, Extreme = false }
local followActive = false
local bypassIgnoreUntil = 0 -- own dashes / teleports must not count as anti-cheat pulls
local origSpeed
local saved = setmetatable({}, { __mode = "k" }) -- hrp -> original props

local function getHum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function getHRP() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end

function isEnemy(p)
    if p == LP then return false end
    if p.Team == nil and LP.Team == nil then return CFG.TreatNoTeamAsEnemy end
    return p.Team ~= LP.Team
end

local function alive(p)
    local c = p.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.Health > 0 then return hum, hrp end
end

-- whitelist: the players picked in the Fur tab dropdown are never auto-swung
local function isWhitelisted(p)
    return wlDrop.Selected[p.Name] == true
end

local function nearestEnemy(myHrp, skipWhitelisted)
    local best, bestHrp, bestD = nil, nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) and not (skipWhitelisted and isWhitelisted(p)) then
            local _, hrp = alive(p)
            if hrp then
                local d = (hrp.Position - myHrp.Position).Magnitude
                if d < bestD then best, bestHrp, bestD = p, hrp, d end
            end
        end
    end
    return best, bestHrp, bestD
end

local MODE_ORDER = { "Heresy", "Pro", "ProPlayer", "Extreme" } -- these four turn each other off
local function activeMode()
    for _, m in ipairs(MODE_ORDER) do
        if state[m] then return m end
    end
end

local function applyHitbox(size)
    local s = Vector3.new(size, size, size)
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            local _, hrp = alive(p)
            if hrp then
                if not saved[hrp] then
                    saved[hrp] = { Size = hrp.Size, Transparency = hrp.Transparency, CanCollide = hrp.CanCollide }
                end
                if hrp.Size ~= s then hrp.Size = s end
                hrp.Transparency = 0.8
                hrp.CanCollide = false
            end
        end
    end
end

local function restoreFrom(tbl)
    for hrp, d in pairs(tbl) do
        if hrp and hrp.Parent then
            hrp.Size, hrp.Transparency, hrp.CanCollide = d.Size, d.Transparency, d.CanCollide
        end
        tbl[hrp] = nil
    end
end
local function restoreHitbox() restoreFrom(saved) end

-- SWING: uses the tool you are holding. If your game swings through a remote,
-- put that remote call in here instead.
local function swing()
    local char = LP.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
end

-- helpers for Pro Player (RunSystem speed + jump cooldown) and Extreme Hitbox (jump power + gravity)
local MX = { extreme = false }

function MX.isRunning()
    if not (MX.runValue and MX.runValue.Parent) then
        local ok, inst = pcall(function() return LP.PlayerGui.RunSystem.Run.Running end)
        MX.runValue = ok and inst or nil
    end
    return MX.runValue ~= nil and MX.runValue.Value == true
end

function MX.clearJumpGuard()
    if MX.jumpConn then
        MX.jumpConn:Disconnect()
        MX.jumpConn = nil
    end
    if MX.jumpHum then
        local h = MX.jumpHum
        MX.jumpHum = nil
        pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
    end
end

-- after every jump the Jumping state is switched off for 1.5s
function MX.jumpGuard(hum)
    if MX.jumpHum == hum then return end
    MX.clearJumpGuard()
    MX.jumpHum = hum
    MX.jumpConn = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Jumping then
            pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end)
            task.delay(CFG.ProPlayer.JumpCooldown, function()
                pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
            end)
        end
    end)
end

function MX.applyExtreme(hum)
    local cfg = CFG.Extreme
    if not MX.extreme then
        MX.extreme = true
        MX.origJump, MX.origUseJump, MX.origGravity = hum.JumpPower, hum.UseJumpPower, workspace.Gravity
    end
    if not hum.UseJumpPower then hum.UseJumpPower = true end
    if hum.JumpPower ~= cfg.JumpPower then hum.JumpPower = cfg.JumpPower end
    if workspace.Gravity ~= cfg.Gravity then workspace.Gravity = cfg.Gravity end
end

function MX.restoreExtreme()
    if not MX.extreme then return end
    MX.extreme = false
    local hum = getHum()
    if hum and MX.origJump then
        hum.UseJumpPower = MX.origUseJump
        hum.JumpPower = MX.origJump
    end
    if MX.origGravity then workspace.Gravity = MX.origGravity end
end

local function setMode(name, on)
    state[name] = on
    if on then
        for _, other in ipairs(MODE_ORDER) do
            if other ~= name then
                state[other] = false
                rows[other].SetOn(false)
            end
        end
    end
    rows[name].SetOn(on)

    local mode = activeMode()
    if mode ~= "ProPlayer" then MX.clearJumpGuard() end
    if mode ~= "Extreme" then MX.restoreExtreme() end

    if mode then
        if origSpeed == nil then
            local hum = getHum()
            origSpeed = hum and hum.WalkSpeed or 16
        end
    else
        restoreHitbox()
        local hum = getHum()
        if hum then hum.WalkSpeed = origSpeed or 16 end
        origSpeed = nil
    end
end

-- Dash (18 studs at speed 100, 4s cooldown)
local dashing = false
local dashReadyAt = 0
local function dash()
    if dashing or os.clock() < dashReadyAt then return end
    local hrp = getHRP()
    if not hrp then return end
    dashing = true
    dashReadyAt = os.clock() + CFG.DashCooldown
    bypassIgnoreUntil = os.clock() + CFG.DashDistance / CFG.DashSpeed + 0.8

    local dashTime = CFG.DashDistance / CFG.DashSpeed
    local goal = hrp.CFrame + hrp.CFrame.LookVector * CFG.DashDistance
    local tw = TweenService:Create(hrp, TweenInfo.new(dashTime, Enum.EasingStyle.Linear), { CFrame = goal })
    tw:Play()

    task.spawn(function() -- swing while dashing
        local t0 = os.clock()
        repeat
            swing()
            task.wait(CFG.SwingDelay)
        until os.clock() - t0 >= dashTime
    end)

    task.spawn(function() -- cooldown countdown on the circle
        local btn = dashCircle.Button
        while os.clock() < dashReadyAt and btn.Parent do
            btn.Text = string.format("%.1f", dashReadyAt - os.clock())
            task.wait(0.1)
        end
        if btn.Parent then btn.Text = "DASH" end
    end)

    tw.Completed:Wait()
    hrp.AssemblyLinearVelocity = Vector3.zero
    dashing = false
end

